# Contoh konfigurasi Streamlit Secrets.
#
# Cara pakai: salin file ini menjadi .streamlit/secrets.toml lalu ganti nilainya
# dengan milik Anda. File secrets.toml sudah masuk .gitignore, jadi tidak akan
# ikut ter-commit. Untuk deployment di Streamlit Cloud, isi nilai yang sama
# lewat menu Settings > Secrets, bukan lewat file.
#
# Konfigurasi di bawah dibaca melalui st.secrets, BUKAN melalui .env.
# GOOGLE_API_KEY justru sebaliknya, dibaca dari .env. Lihat .env.example.
#
# Bagian ini opsional. Tanpa konfigurasi di bawah, chatbot tetap berjalan normal;
# hanya pencatatan riwayat chat dan rating feedback ke Google Sheets yang mati.

# ID spreadsheet tempat log disimpan. Ambil dari URL Google Sheets, bagian yang
# berada di antara /d/ dan /edit :
#   https://docs.google.com/spreadsheets/d/<GSHEET_ID>/edit
GSHEET_ID = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789ABCDE"

# Service account Google Cloud yang dipakai aplikasi untuk menulis ke spreadsheet.
#
# Langkah membuatnya:
#   1. Google Cloud Console > IAM & Admin > Service Accounts > Create
#   2. Buat key bertipe JSON, lalu unduh berkasnya
#   3. Pindahkan setiap field dari JSON itu ke bagian di bawah
#   4. Buka spreadsheet Anda, klik Share, lalu beri akses Editor ke client_email
#
# Simpan berkas JSON aslinya di luar folder proyek supaya tidak berisiko
# ter-commit atau ikut terbawa saat folder proyek dibagikan.
[gcp_service_account]
type = "service_account"
project_id = "nama-project-anda"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = "-----BEGIN PRIVATE KEY-----\nISI_KUNCI_PRIVAT_ANDA_DI_SINI\n-----END PRIVATE KEY-----\n"
client_email = "nama-service-account@nama-project-anda.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nama-service-account%40nama-project-anda.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
